{
  "_comment": "BIS Platform Caddy WAF Rules — defense-in-depth layer before OpenAppSec",
  "rules": [
    {
      "id": "BIS-001",
      "description": "Block SQL injection attempts in query strings",
      "phase": "request",
      "action": "block",
      "score": 10,
      "targets": ["QUERY_STRING", "REQUEST_BODY"],
      "pattern": "(?i)(union\\s+select|insert\\s+into|drop\\s+table|delete\\s+from|update\\s+set|exec\\s*\\(|execute\\s*\\(|xp_cmdshell|sp_executesql)"
    },
    {
      "id": "BIS-002",
      "description": "Block XSS attempts",
      "phase": "request",
      "action": "block",
      "score": 8,
      "targets": ["QUERY_STRING", "REQUEST_BODY", "REQUEST_HEADERS"],
      "pattern": "(?i)(<script[^>]*>|javascript:\\s*|on(load|error|click|mouseover)\\s*=|eval\\s*\\(|document\\.cookie|document\\.write)"
    },
    {
      "id": "BIS-003",
      "description": "Block path traversal attempts",
      "phase": "request",
      "action": "block",
      "score": 9,
      "targets": ["REQUEST_URI", "QUERY_STRING"],
      "pattern": "(\\.\\./|\\.\\.\\\\|%2e%2e%2f|%2e%2e/|\\.%2e/|%2e%2e%5c)"
    },
    {
      "id": "BIS-004",
      "description": "Block SSRF attempts targeting internal services",
      "phase": "request",
      "action": "block",
      "score": 10,
      "targets": ["QUERY_STRING", "REQUEST_BODY"],
      "pattern": "(?i)(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|169\\.254\\.169\\.254|::1|internal\\.bis|redis:|postgres:|keycloak:|permify:|temporal:)"
    },
    {
      "id": "BIS-005",
      "description": "Block command injection attempts",
      "phase": "request",
      "action": "block",
      "score": 10,
      "targets": ["QUERY_STRING", "REQUEST_BODY"],
      "pattern": "(?i)(;\\s*(ls|cat|wget|curl|bash|sh|python|perl|ruby|php)\\s|\\|\\s*(ls|cat|wget|curl|bash)|`[^`]*`|\\$\\([^)]*\\))"
    },
    {
      "id": "BIS-006",
      "description": "Block JWT token brute-force — suspicious JWT patterns",
      "phase": "request",
      "action": "log",
      "score": 5,
      "targets": ["REQUEST_HEADERS:Authorization"],
      "pattern": "Bearer\\s+[A-Za-z0-9_-]{1,10}\\.[A-Za-z0-9_-]{1,10}\\."
    },
    {
      "id": "BIS-007",
      "description": "Block requests missing required BIS edge token (WAF bypass attempt)",
      "phase": "request",
      "action": "log",
      "score": 7,
      "targets": ["REQUEST_HEADERS"],
      "pattern": "^(?!.*X-BIS-Edge-Token).*$",
      "comment": "Logged only — enforcement done at APISIX level"
    },
    {
      "id": "BIS-008",
      "description": "Block large request bodies on auth endpoints",
      "phase": "request",
      "action": "block",
      "score": 6,
      "targets": ["REQUEST_URI"],
      "pattern": "^/api/auth/",
      "conditions": [
        {"type": "size", "target": "REQUEST_BODY", "operator": "gt", "value": 65536}
      ]
    },
    {
      "id": "BIS-009",
      "description": "Detect and block NoSQL injection attempts",
      "phase": "request",
      "action": "block",
      "score": 9,
      "targets": ["QUERY_STRING", "REQUEST_BODY"],
      "pattern": "(?i)(\\$where|\\$gt|\\$lt|\\$ne|\\$in|\\$nin|\\$regex|\\$exists|\\$type|\\$mod|\\$all|\\$size|\\$elemMatch|\\$not|\\$nor|\\$or|\\$and)\\s*:"
    },
    {
      "id": "BIS-010",
      "description": "Block prototype pollution attempts",
      "phase": "request",
      "action": "block",
      "score": 8,
      "targets": ["QUERY_STRING", "REQUEST_BODY"],
      "pattern": "(?i)(__proto__|constructor\\[prototype\\]|prototype\\[constructor\\])"
    }
  ],
  "anomaly_scoring": {
    "threshold": 10,
    "action": "block"
  },
  "ip_blacklist": {
    "enabled": true,
    "auto_block_threshold": 20,
    "block_duration": "1h"
  },
  "geo_blocking": {
    "enabled": false,
    "blocked_countries": []
  }
}
