# Copy to a protected secret-manager-rendered file; do not commit the rendered file.
# Every <REQUIRED_...> marker must be replaced by a real approved value.

# Signed images from the operator's approved registry/digest policy.
VAULT_IMAGE=<REQUIRED_VAULT_IMAGE_WITH_DIGEST>
KES_IMAGE=<REQUIRED_KES_IMAGE_WITH_DIGEST>
MINIO_IMAGE=<REQUIRED_MINIO_IMAGE_WITH_DIGEST>
PERMIFY_IMAGE=<REQUIRED_PERMIFY_IMAGE_WITH_DIGEST>
CADDY_IMAGE=<REQUIRED_CADDY_IMAGE_WITH_DIGEST>
MINIO_MC_IMAGE=<REQUIRED_MINIO_CLIENT_IMAGE_WITH_DIGEST>

# Protected host paths, owned root:root and mounted read-only where possible.
BIS_ONPREM_CONFIG_DIR=<REQUIRED_ABSOLUTE_CONFIG_DIRECTORY>
BIS_ONPREM_PKI_DIR=<REQUIRED_ABSOLUTE_PKI_DIRECTORY>
BIS_ONPREM_CA_BUNDLE_PATH=<REQUIRED_ABSOLUTE_BFF_CA_BUNDLE_PATH>

# Network ports; bind Vault, KES, and MinIO console to loopback unless a hardened proxy is configured.
BIS_ONPREM_VAULT_PORT=8200
BIS_ONPREM_KES_PORT=7373
BIS_ONPREM_MINIO_BIND_ADDRESS=127.0.0.1
BIS_ONPREM_MINIO_PORT=9000
BIS_ONPREM_MINIO_CONSOLE_PORT=9001

# BFF staging profile.
BIS_DEPLOYMENT_ENV=staging
DATABASE_URL=<REQUIRED_POSTGRESQL_STAGING_URL>
PERMIFY_DATABASE_URI=<REQUIRED_PERMIFY_POSTGRESQL_URL>
PERMIFY_URL=https://permify-tls:8443
PERMIFY_TENANT_ID=<REQUIRED_PERMIFY_TENANT_ID>
PERMIFY_API_KEY=<REQUIRED_BFF_CHECK_ONLY_PERMIFY_KEY>
BIS_EVIDENCE_S3_ENDPOINT=https://minio:9000
BIS_EVIDENCE_S3_REGION=onprem-1
BIS_EVIDENCE_S3_BUCKET=<REQUIRED_VERSIONED_STAGING_BUCKET>
BIS_EVIDENCE_S3_FORCE_PATH_STYLE=true
BIS_EVIDENCE_S3_SSE_ALGORITHM=aws:kms
BIS_EVIDENCE_S3_KMS_KEY_ID=<REQUIRED_KES_EVIDENCE_KEY_NAME>
BIS_EVIDENCE_ACTIVE_KEY_VERSION=<REQUIRED_APPLICATION_EVIDENCE_KEY_VERSION>
BIS_EVIDENCE_KEYRING=<REQUIRED_VERSIONED_32_BYTE_BASE64_KEYRING>

# Leave both blank only when an on-premises workload identity/default SDK credential source is configured.
# Otherwise set both through the secret manager, never in a shell history or committed file.
BIS_EVIDENCE_S3_ACCESS_KEY=
BIS_EVIDENCE_S3_SECRET_KEY=

# Vault/KES. Vault must be initialized and unsealed through an approved production ceremony before KES starts.
KES_ROOT_IDENTITY=<REQUIRED_KES_BREAK_GLASS_IDENTITY_HASH>
MINIO_KES_IDENTITY=<REQUIRED_MINIO_KES_CLIENT_IDENTITY_HASH>
VAULT_KES_ROLE_ID=<REQUIRED_VAULT_APPROLE_ID>
VAULT_KES_SECRET_ID=<REQUIRED_VAULT_APPROLE_SECRET_ID>
MINIO_KES_API_KEY=<REQUIRED_MINIO_KES_API_KEY>
MINIO_ROOT_USER=<REQUIRED_MINIO_OPERATOR_USER>
MINIO_ROOT_PASSWORD=<REQUIRED_MINIO_OPERATOR_PASSWORD>
BIS_ONPREM_MINIO_BOOTSTRAP_CONFIRMATION=I_APPROVE_SYNTHETIC_STAGING_BUCKET_BOOTSTRAP
MINIO_SYNTHETIC_RETENTION_DAYS=7
